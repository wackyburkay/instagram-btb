{
  "manifest_version": 3,
  "name": "Instagram: Block the Blocker",
  "version": "0.1.0",
  "description": "Block an Instagram account that has already blocked you, from your own logged-in session.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "action": {
    "default_title": "Block the Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-btb@wackyburkay",
      "strict_min_version": "128.0"
    }
  }
}
